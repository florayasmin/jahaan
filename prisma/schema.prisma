// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Show {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  releaseYear   Int?
  totalEpisodes Int?
  channel       String?
  director      String?
  writer        String?
  cast          String?
  status        String?
  rating        Float?
  episodes      Episode[]
  genres        Genre[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Indexes for search performance
  @@index([name])                   // fast lookup by title
  @@index([status, releaseYear])    // fast filtering by status + year
  @@index([rating])                 // fast sorting/filtering by rating
}

model Episode {
  id            Int       @id @default(autoincrement())
  showId        Int
  show          Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  episodeNumber Int
  seasonNumber  Int
  title         String?
  airDate       DateTime?
  duration      Int?
  description   String?
  createdAt     DateTime  @default(now())

  @@unique([showId, seasonNumber, episodeNumber])
  @@index([showId])                 // fast episode lookup by show
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  shows Show[]
}
